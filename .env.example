# Copy to .env.local, or generate it with `npm run db:env` while local Supabase runs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# Google Gemini — server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Lotse runtime (apps/server, all optional; defaults in apps/server/src/lib/lotse/config.ts) ---
# Kill switch: 1 = every /api/lotse/* call answers 503.
LOTSE_DISABLED=
# Allow anonymous calls (identity = x-lotse-session) even when NODE_ENV=production. Always allowed in dev.
LOTSE_DEV_AUTH=
# Feature knowledge: "fixture" (default, bundled demo-CRM list) or "db" (dashboard tables apps/app_features, fixture fallback).
LOTSE_KNOWLEDGE_SOURCE=
# 0 = never call the Decisions API to break ties in tier selection (heuristic only).
LOTSE_TIER_CLASSIFIER=
# Requests per minute per caller (user id, else x-lotse-session). Defaults: 20 / 6 / 6 / 20.
LOTSE_LIMIT_ASK_PER_MIN=
LOTSE_LIMIT_DECIDE_PER_MIN=
LOTSE_LIMIT_EVENTS_PER_MIN=
LOTSE_LIMIT_PREFS_PER_MIN=
# Voice sessions per minute (one Live token = one spoken question, NOT LLM tokens). Defaults: 8 per session, 60 global.
LOTSE_LIMIT_LIVE_TOKENS_PER_MIN=
LOTSE_LIMIT_LIVE_TOKENS_GLOBAL_PER_MIN=
# Global cap per minute for ask/decide/events/prefs across all callers. Default 300.
LOTSE_LIMIT_GLOBAL_PER_MIN=
# LLM tokens (input+output, ask+decide) per caller per UTC day. Default 200000.
LOTSE_DAILY_TOKEN_BUDGET=
