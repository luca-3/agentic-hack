# Copy to .env.local, or generate it with `npm run db:env` while local Supabase runs.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# Google Gemini — server-only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Valo runtime (apps/server, all optional; defaults in apps/server/src/lib/lotse/config.ts) ---
# Kill switch: 1 = every /api/lotse/* call answers 503.
LOTSE_DISABLED=
# Allow anonymous calls (identity = x-lotse-session) even when NODE_ENV=production. Always allowed in dev.
LOTSE_DEV_AUTH=
# Feature knowledge: "auto" (default: dashboard tables apps/app_features, bundled demo-CRM fixture as fallback), "db" (same, warns when the app is missing) or "fixture" (never reads the DB).
LOTSE_KNOWLEDGE_SOURCE=
# 0 = never call the Decisions API to break ties in tier selection (heuristic only).
LOTSE_TIER_CLASSIFIER=
# Requests per minute per caller (user id, else x-lotse-session). Defaults: ask 20, state 60, intent 60, decide 60, events 6, prefs 20.
# state/intent/decide run once per observation cycle (staged pipeline, extension coalesces ~1 s).
LOTSE_LIMIT_ASK_PER_MIN=
LOTSE_LIMIT_STATE_PER_MIN=
LOTSE_LIMIT_INTENT_PER_MIN=
LOTSE_LIMIT_DECIDE_PER_MIN=
LOTSE_LIMIT_EVENTS_PER_MIN=
LOTSE_LIMIT_PREFS_PER_MIN=
# Model timeouts (ms) for /state and /intent. Defaults 6000 / 8000 (the extension aborts after 20 s).
LOTSE_TIMEOUT_STATE_MS=
LOTSE_TIMEOUT_INTENT_MS=
# Voice sessions per minute (one Live token = one spoken question, NOT LLM tokens). Defaults: 8 per session, 60 global.
LOTSE_LIMIT_LIVE_TOKENS_PER_MIN=
LOTSE_LIMIT_LIVE_TOKENS_GLOBAL_PER_MIN=
# Global cap per minute for ask/state/intent/decide/events/prefs across all callers (per kind). Default 300.
LOTSE_LIMIT_GLOBAL_PER_MIN=
# --- App policy for the extension (GET /api/lotse/policy, D-27) ---
# Hosts treated as CORPUS: its vehicle/fleet pages hold real data. Default: localhost:3100,127.0.0.1:3100 (plus any dashboard app named "CORPUS…").
LOTSE_CORPUS_HOSTS=
# Route patterns blocked on CORPUS hosts (`*` = anything, case-insensitive, matched against path + query + hash). Default: *fahrzeug*,*vehicle*,*fleet*,*fuhrpark*
LOTSE_FLEET_ROUTES=
# Extra blocked patterns per app host: "host=pattern|pattern;host2=pattern", e.g. "localhost:3100=/admin/*|/export*"
LOTSE_BLOCKED_ROUTES=
# Hosts that are no org's app: 1 = allowed (empty blocklist), 0 = refused. Default: allowed in dev, refused in production.
LOTSE_ALLOW_UNKNOWN_APPS=
# GET /policy calls per minute per caller (the extension caches per host for 60 s). Default 60.
LOTSE_LIMIT_POLICY_PER_MIN=
# LLM tokens (input+output; state+intent+decide+ask) per caller per UTC day. Default 2000000 (~8k per observation cycle).
LOTSE_DAILY_TOKEN_BUDGET=
# --- Agent memory + knowledge gaps (D-28) ---
# 0 = don't learn from /ask answers (no topic call, no gaps, no memory evidence). Reading active memories stays on.
LOTSE_MEMORY=
# Days without new supporting evidence before a learned memory expires (admin-written ones never expire). Default 60.
LOTSE_MEMORY_TTL_DAYS=
# Salt for hashing pseudonymous subject keys in agent_memory_evidence / knowledge_gap_subjects. Default "lotse-memory-v1".
LOTSE_PSEUDONYM_SALT=
