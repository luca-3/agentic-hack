{
  "name": "agentic-hack",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @lotse/server",
    "dev:dashboard": "npm run dev -w @lotse/dashboard",
    "dev:extension": "npm run dev -w @lotse/extension",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo:crm": "python3 -m http.server 4000 --directory demo-crm",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:env": "node scripts/supabase-env.mjs",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "ai:check": "node --env-file=.env.local scripts/ai-check.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
